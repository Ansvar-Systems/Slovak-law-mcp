{
  "$schema": "./golden-tests.schema.json",
  "version": "1.1",
  "mcp_name": "Slovak Law MCP",
  "description": "Golden contract tests for the Slovak Law MCP -- 12 tests covering provision retrieval, search, citation, cross-reference, and negative cases. Re-blessed 2026-06-11 against the real Slov-Lex corpus (issue #49): assertions and queries use the Slovak statutory text.",
  "tests": [
    {
      "id": "sk-001",
      "category": "article_retrieval",
      "description": "Retrieve Data Protection Act §1 (Zákon č. 18/2018 Z.z.) -- subject matter (ochrana osobných údajov)",
      "tool": "get_provision",
      "input": {
        "document_id": "act-18-2018",
        "provision_ref": "§1"
      },
      "assertions": {
        "result_not_empty": true,
        "any_result_contains": [
          "osobných údajov",
          "ochranu práv fyzických osôb",
          "Úradu na ochranu osobných údajov"
        ],
        "fields_present": [
          "content",
          "provision_ref"
        ],
        "text_not_empty": true
      }
    },
    {
      "id": "sk-002",
      "category": "article_retrieval",
      "description": "Retrieve Cybersecurity Act §1 (Zákon č. 69/2018 Z.z.) -- scope (kybernetická bezpečnosť)",
      "tool": "get_provision",
      "input": {
        "document_id": "act-69-2018",
        "provision_ref": "§1"
      },
      "assertions": {
        "result_not_empty": true,
        "any_result_contains": [
          "kybernetickej bezpečnosti",
          "prevádzkovateľa základnej služby",
          "bezpečnostné opatrenia"
        ],
        "fields_present": [
          "content",
          "provision_ref"
        ],
        "text_not_empty": true
      }
    },
    {
      "id": "sk-003",
      "category": "article_retrieval",
      "description": "Retrieve Criminal Code §247 (Zákon č. 300/2005 Z.z.) -- neoprávnený prístup do počítačového systému",
      "tool": "get_provision",
      "input": {
        "document_id": "act-300-2005",
        "provision_ref": "§247"
      },
      "assertions": {
        "result_not_empty": true,
        "any_result_contains": [
          "počítačového systému",
          "neoprávnený prístup",
          "bezpečnostné opatrenie",
          "odňatím slobody"
        ],
        "fields_present": [
          "content",
          "provision_ref"
        ],
        "text_not_empty": true
      }
    },
    {
      "id": "sk-004",
      "category": "article_retrieval",
      "description": "Retrieve Commercial Code §17 (Zákon č. 513/1991 Zb.) -- obchodné tajomstvo (trade secret)",
      "tool": "get_provision",
      "input": {
        "document_id": "act-513-1991",
        "provision_ref": "§17"
      },
      "assertions": {
        "result_not_empty": true,
        "any_result_contains": [
          "obchodné tajomstvo",
          "obchodnej, výrobnej alebo technickej povahy"
        ],
        "fields_present": [
          "content",
          "provision_ref"
        ],
        "text_not_empty": true
      }
    },
    {
      "id": "sk-005",
      "category": "search",
      "description": "Full-text search for 'osobné údaje' returns Data Protection Act provisions",
      "tool": "search_legislation",
      "input": {
        "query": "osobné údaje"
      },
      "assertions": {
        "result_not_empty": true,
        "min_results": 1,
        "any_result_contains": [
          "osobné údaje",
          "ochrane osobných údajov"
        ]
      }
    },
    {
      "id": "sk-006",
      "category": "search",
      "description": "Full-text search for 'kybernetická bezpečnosť' returns Cybersecurity Act provisions",
      "tool": "search_legislation",
      "input": {
        "query": "kybernetická bezpečnosť"
      },
      "assertions": {
        "result_not_empty": true,
        "min_results": 1,
        "any_result_contains": [
          "kybernetick",
          "bezpečnost",
          "incident"
        ]
      }
    },
    {
      "id": "sk-007",
      "category": "search",
      "description": "Full-text search for 'kritická infraštruktúra' returns Critical Infrastructure Act provisions",
      "tool": "search_legislation",
      "input": {
        "query": "kritická infraštruktúra"
      },
      "assertions": {
        "result_not_empty": true,
        "min_results": 1,
        "any_result_contains": [
          "kritick",
          "infraštruktúr"
        ]
      }
    },
    {
      "id": "sk-008",
      "category": "citation_roundtrip",
      "description": "Citation for Data Protection Act §5 includes slov-lex.sk URL pattern",
      "tool": "get_provision",
      "input": {
        "document_id": "act-18-2018",
        "provision_ref": "§5"
      },
      "assertions": {
        "result_not_empty": true,
        "citation_url_pattern": "slov-lex\\.sk",
        "text_not_empty": true
      }
    },
    {
      "id": "sk-009",
      "category": "citation_roundtrip",
      "description": "Citation for Cybersecurity Act §10 includes slov-lex.sk URL pattern",
      "tool": "get_provision",
      "input": {
        "document_id": "act-69-2018",
        "provision_ref": "§10"
      },
      "assertions": {
        "result_not_empty": true,
        "citation_url_pattern": "slov-lex\\.sk",
        "text_not_empty": true
      }
    },
    {
      "id": "sk-010",
      "category": "eu_cross_reference",
      "description": "Data Protection Act §104 cross-reference to EU GDPR -- Slovak DPA implements Regulation (EU) 2016/679",
      "tool": "get_provision_eu_basis",
      "input": {
        "document_id": "act-18-2018",
        "provision_ref": "§104"
      },
      "assertions": {
        "result_not_empty": true,
        "any_result_contains": [
          "2016/679",
          "nariadenie (EÚ) 2016/679",
          "implements"
        ]
      }
    },
    {
      "id": "sk-011",
      "category": "negative_test",
      "description": "Non-existent Slovak law returns graceful error or empty result",
      "tool": "get_provision",
      "input": {
        "document_id": "act-9999-2099",
        "provision_ref": "§1"
      },
      "assertions": {
        "handles_gracefully": true
      }
    },
    {
      "id": "sk-012",
      "category": "negative_test",
      "description": "Malformed provision reference returns graceful error or empty result",
      "tool": "get_provision",
      "input": {
        "document_id": "act-18-2018",
        "provision_ref": "§999ZZZ-INVALID"
      },
      "assertions": {
        "handles_gracefully": true
      }
    }
  ]
}
